# gex-engine — copy to .env locally. NEVER commit real secrets.

# Options market data provider adapter
MARKET_DATA_PROVIDER=          # intrinio | theta | databento | polygon
MARKET_DATA_API_KEY=

# Underlyings to compute (comma-separated)
UNDERLYINGS=SPX,NDX

# Recompute cadence in seconds (intraday model refresh)
RECOMPUTE_INTERVAL_SECONDS=60
